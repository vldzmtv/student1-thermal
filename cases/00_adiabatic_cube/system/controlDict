FoamFile
{
    version 2.0;
    format ascii;
    class dictionary;
    object controlDict;
}

application laplacianFoam;
startFrom startTime;
startTime 0;
stopAt endTime;
endTime 1;
deltaT 0.01;
writeControl timeStep;
writeInterval 10;
purgeWrite 0;
writeFormat ascii;
writePrecision 12;
writeCompression off;
timeFormat general;
timePrecision 6;
runTimeModifiable true;
functions
{
    temperatureMinMax
    {
        type            fieldMinMax;
        libs            (fieldFunctionObjects);
        fields          (T);
        location        yes;
        writeControl    writeTime;
    }
}
